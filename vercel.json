{
  "rewrites": [
    { "source": "/sponsor", "destination": "/sponsor.html" },
    { "source": "/sponsors", "destination": "/sponsor.html" },
    { "source": "/join", "destination": "/join.html" },
    { "source": "/signup", "destination": "/join.html" }
  ],
  "redirects": [
    { "source": "/login", "destination": "/#/login", "permanent": false },
    { "source": "/faq", "destination": "/about.html#faq", "permanent": false },
    { "source": "/about", "destination": "/about.html", "permanent": true },
    { "source": "/hoodie", "destination": "/hoodie.html", "permanent": true },
    { "source": "/privacy", "destination": "/privacy.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/checkin.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
